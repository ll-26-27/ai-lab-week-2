# Copy this file to .env at the repo root, then paste in the keys you were given in class.
#   Mac / Windows (PowerShell):   cp .env.example .env
# .env is gitignored and must never be committed or pasted into Slack. .env.example is committed and stays empty.
# No key is needed for --dry-run.

# Harvard API Portal (https://portal.apis.huit.harvard.edu): one key for huit-bedrock (Claude), huit-openai, huit-gemini.
#   node utils/generate-text.mjs huit-bedrock "..." --model us.anthropic.claude-sonnet-5
HUIT_API_KEY=

# OpenRouter (https://openrouter.ai): one key, many image and text models.
#   node utils/generate-image.mjs openrouter "..." --model google/gemini-2.5-flash-image
OPENROUTER_API_KEY=

# fal (https://fal.ai): image endpoints such as fal-ai/flux/dev. Paste the whole key, colon included.
FAL_API_KEY=
